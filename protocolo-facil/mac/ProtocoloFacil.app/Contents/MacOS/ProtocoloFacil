#!/bin/bash
# Lanzador: copia la interfaz a una ubicación fija del usuario y la abre en Safari.
# La ubicación fija evita que el almacenamiento local cambie si movés el paquete.
set -euo pipefail
pf_resources="$(cd "$(dirname "$0")/../Resources" && pwd)"
pf_target="$HOME/Library/Application Support/ProtocoloFacil/Interface"
/bin/mkdir -p "$pf_target"
for pf_file in index.html style.css engine.js notarial.js store.js ui.js; do
    /bin/cp "$pf_resources/$pf_file" "$pf_target/$pf_file"
done
/usr/bin/open -a Safari "$pf_target/index.html"

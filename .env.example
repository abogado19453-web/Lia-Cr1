# Environment Configuration Example
# Copy this file to .env and fill in your values

# ==============================================
# LLM PROVIDER SELECTION
# ==============================================
# Options: claude | openai
LLM_PROVIDER=claude

# ==============================================
# CLAUDE (Anthropic) Configuration
# ==============================================
# Get your API key at: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ==============================================
# OPENAI Configuration
# ==============================================
# Get your API key at: https://platform.openai.com/
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo

# ==============================================
# SERVER Configuration
# ==============================================
PORT=3000
NODE_ENV=development

# ==============================================
# DATABASE Configuration (Optional)
# ==============================================
# For PostgreSQL (recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/lia-cr
# For SQLite (local development)
DATABASE_URL=sqlite:./data/lia-cr.db

# ==============================================
# EXTERNAL SERVICES
# ==============================================
# SCIJ API configuration
SCIJ_API_URL=https://scij.poder-judicial.go.cr/api
SCIJ_API_KEY=your-scij-api-key

# Poder Judicial API
PODER_JUDICIAL_URL=https://www.poder-judicial.go.cr
PODER_JUDICIAL_API_KEY=your-poder-judicial-api-key

# Registro Nacional
REGISTRO_NACIONAL_URL=https://www.registronacional.go.cr
REGISTRO_NACIONAL_API_KEY=your-registro-nacional-api-key

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ==============================================
# SECURITY
# ==============================================
ENABLE_HTTPS=false
JWT_SECRET=your-jwt-secret-key-here

# ==============================================
# CACHE Configuration
# ==============================================
CACHE_ENABLED=true
CACHE_TTL=3600

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=15m

# ==============================================
# FEATURE FLAGS
# ==============================================
ENABLE_DOCUMENT_GENERATION=true
ENABLE_LEGISLATION_SEARCH=true
ENABLE_JURISPRUDENCE_SEARCH=true
ENABLE_NOTARIAL_CALCULATIONS=true
ENABLE_INTEGRATION_SCIJ=true
ENABLE_INTEGRATION_PODER_JUDICIAL=true

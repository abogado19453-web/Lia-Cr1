# Base de datos (SQLite para desarrollo; para PostgreSQL cambie provider en prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secreto para firmar sesiones: genere uno con `openssl rand -base64 32`
AUTH_SECRET=""

# Clave de API de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=""
# Modelo (opcional)
CLAUDE_MODEL="claude-opus-5-5"

# Carpeta donde se guardan los documentos subidos
UPLOAD_DIR="./uploads"

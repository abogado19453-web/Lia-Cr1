# Base de datos (SQLite para desarrollo; para PostgreSQL cambie provider en prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secreto para firmar sesiones: genere uno con `openssl rand -base64 32`
AUTH_SECRET=""

# Clave de API de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=""
# Modelo (opcional)
CLAUDE_MODEL="claude-opus-5-5"

# Opcional: clave propia para cifrar las claves de IA guardadas en la base (si no, se usa AUTH_SECRET)
LEXCR_CLAVE_CIFRADO=""
# En servidores compartidos, "true" impide conectar proveedores de IA en direcciones de red local
LEXCR_BLOQUEAR_IA_LOCAL=""

# Carpeta donde se guardan los documentos subidos
UPLOAD_DIR="./uploads"

# Ingreso con Google (opcional). Cree credenciales OAuth "Aplicación web" en
# https://console.cloud.google.com/apis/credentials con el URI de redirección
#   {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# URL pública de la aplicación (sin barra final), p. ej. https://despacho.ejemplo.cr
APP_URL=""

# Cobro de suscripciones. Con PLANES_ACTIVOS distinto de "true" no hay límites, cobros ni menú de planes.
PLANES_ACTIVOS="false"
# Correos (separados por coma) con acceso al panel «Plataforma» para aprobar pagos
PLATFORM_ADMIN_EMAILS=""
# Pago manual: si se dejan vacíos, el método no se ofrece
PAGO_SINPE_NUMERO=""
PAGO_IBAN=""
PAGO_TITULAR=""
# Pago con tarjeta (Stripe). Webhook: {APP_URL}/api/stripe/webhook
# con los eventos checkout.session.completed, checkout.session.async_payment_succeeded y checkout.session.expired
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
